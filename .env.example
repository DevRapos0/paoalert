# ============================================================
#  PãoAlert — Configurações
# ============================================================

# Porta do servidor
PORT=3000

# --- Evolution API ---
# URL do seu servidor Evolution API (ex: http://localhost:8080)
EVOLUTION_API_URL=http://localhost:8080
# Chave global da Evolution API (definida no docker-compose)
EVOLUTION_API_KEY=sua_chave_aqui
# Nome da instância WhatsApp criada na Evolution API
EVOLUTION_INSTANCE=paocalert

# --- Padaria ---
PADARIA_NOME=Padaria Aconchego
# Número WhatsApp Business da padaria (formato: 5511999999999)
PADARIA_NUMERO=5511999999999

# --- Segurança botão físico ---
# Token secreto para o ESP8266 (qualquer string aleatória)
IOT_SECRET=mude_este_token_secreto

# --- Cadastro automático via QR ---
# Mensagem que o cliente deve enviar para ser cadastrado
KEYWORD_CADASTRO=quero receber alertas
KEYWORD_DESCADASTRO=parar alertas
